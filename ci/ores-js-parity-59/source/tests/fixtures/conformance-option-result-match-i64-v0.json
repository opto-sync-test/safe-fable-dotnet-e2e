  "negativeCases": [
    {
      "id": "missing-none",
      "expect": "reject",
      "diagnosticClass": "non-exhaustive",
      "source": "define module core as\npub fnc f(Option<int> v):int {return match v over {on Some(n) {return n;} };}\nend\n"
    },
    {
      "id": "duplicate-some",
      "expect": "reject",
      "diagnosticClass": "duplicate-variant",
      "source": "define module core as\npub fnc f(Option<int> v):int {return match v over {on Some(n) {return n;} on Some(m) {return m;} };}\nend\n"
    },
    {
      "id": "mixed-families",
      "expect": "reject",
      "diagnosticClass": "variant-family-mismatch",
      "source": "define module core as\npub fnc f(Option<int> v):int {return match v over {on Some(n) {return n;} on Err(e) {return e;} };}\nend\n"
    },
    {
      "id": "wrong-subject",
      "expect": "reject",
      "diagnosticClass": "subject-type-mismatch",
      "source": "define module core as\npub fnc f(int v):int {return match v over {on Some(n) {return n;} on None {return 0;} };}\nend\n"
    },
    {
      "id": "parameter-shadow",
      "expect": "reject",
      "diagnosticClass": "capture-shadow",
      "source": "define module core as\npub fnc f(Option<int> v):int {return match v over {on Some(v) {return v;} on None {return 0;} };}\nend\n"
    },
    {
      "id": "nested-shadow",
      "expect": "reject",
      "diagnosticClass": "capture-shadow",
      "source": "define module core as\npub fnc f(Option<int> v):int {return match v over {on Some(n) {return match Some(n) over {on Some(n) {return n;} on None {return 0;} };} on None {return 0;} };}\nend\n"
    },
    {
      "id": "none-has-no-payload",
      "expect": "reject",
      "diagnosticClass": "none-payload",
      "source": "define module core as\npub fnc f(Option<int> v):int {return match v over {on Some(n) {return n;} on None(n) {return n;} };}\nend\n"
    },
    {
      "id": "wrong-return-type",
      "expect": "reject",
      "diagnosticClass": "arm-type-mismatch",
      "source": "define module core as\npub fnc f(Option<int> v):bool {return match v over {on Some(n) {return n;} on None {return false;} };}\nend\n"
    },
    {
      "id": "wildcard-instead-of-none",
      "expect": "reject",
      "diagnosticClass": "non-exhaustive",
      "source": "define module core as\npub fnc f(Option<int> v):int {return match v over {on Some(n) {return n;} else {return 0;} };}\nend\n"
    }
