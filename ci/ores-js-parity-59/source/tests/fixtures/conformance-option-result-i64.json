        "int": "0"
      }
    },
    {
      "id": "option-value",
      "function": "optional_or_zero",
      "args": [
        "7"
      ],
      "expected": {
        "int": "7"
      }
    },
    {
      "id": "result-err",
      "function": "checked_nonnegative",
      "args": [
