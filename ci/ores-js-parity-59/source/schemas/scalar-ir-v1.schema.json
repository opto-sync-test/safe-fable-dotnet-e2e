{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ores-truffle-oreslang/oreslang-source.js/blob/feat/scalar-ir-v1-js-backend/schemas/scalar-ir-v1.schema.json",
  "title": "Experimental Oreslang scalar IR v1",
  "description": "Wire-format structural schema. The validator enforces signed-i64 range, references, arity, and call-graph acyclicity. This schema is not the canonical Oreslang language IR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dialect",
    "integerModel",
    "functions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dialect": {
      "const": "oreslang.scalar"
    },
    "integerModel": {
      "const": "signed-i64-wrap-provisional"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/function"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 511
    },
    "intLiteral": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$"
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "pub",
        "params",
        "resultType",
        "body"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "pub": {
          "type": "boolean"
        },
        "params": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "resultType": {
          "const": "int"
        },
        "body": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "expr": {
      "oneOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "$ref": "#/$defs/parameter"
        },
        {
          "$ref": "#/$defs/negation"
        },
        {
          "$ref": "#/$defs/binary"
        },
        {
          "$ref": "#/$defs/call"
        }
      ]
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "int"
        },
        "value": {
          "$ref": "#/$defs/intLiteral"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "param"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      }
    },
    "negation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "inner"
      ],
      "properties": {
        "kind": {
          "const": "neg"
        },
        "inner": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "op",
        "left",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "binary"
        },
        "op": {
          "enum": [
            "+",
            "-",
            "*",
            "%"
          ]
        },
        "left": {
          "$ref": "#/$defs/expr"
        },
        "right": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "call"
        },
        "target": {
          "$ref": "#/$defs/index"
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/expr"
          }
        }
      }
    }
  }
}
