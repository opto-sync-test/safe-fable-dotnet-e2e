{
  "name": "@oreslang/source-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/compiler.mjs",
    "./build-package": "./src/build-package.mjs",
    "./host-bridge": "./src/host-bridge.mjs",
    "./host-bridge.node": "./src/host-bridge.node.mjs",
    "./package-admission": "./src/package-admission.mjs",
    "./load-trusted-package.node": "./src/load-trusted-package.node.mjs",
    "./scalar-ir": "./src/scalar-ir.mjs",
    "./program-v2": "./src/program-v2.mjs",
    "./class-methods-v1": "./src/class-methods-v1.mjs",
    "./class-method-ir-v1": "./src/class-method-ir-v1.mjs",
    "./symbol-wire-v1": "./src/symbol-wire-v1.mjs",
    "./multiple-inheritance": "./src/multiple-inheritance.mjs",
    "./program-ir-v2": "./src/program-ir-v2.mjs",
    "./java-js-parity-v1": "./src/java-js-parity-v1.mjs",
    "./js-numeric-boundary-v1": "./src/js-numeric-boundary-v1.mjs",
    "./static-facts-v0.node": "./src/static-facts-v0.node.mjs",
    "./actor-host.browser": "./src/actor-host.browser.mjs",
    "./actor-host.node": "./src/actor-host.node.mjs",
    "./worker-actor-client": "./src/worker-actor-client.mjs",
    "./freestanding-core": "./src/freestanding-core.mjs",
    "./freestanding-core-link": "./src/freestanding-core-link.mjs"
  },
  "bin": {
    "oreslang-jsc": "./bin/oreslang-jsc.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node bin/oreslang-jsc.mjs --check tests/fixtures/arithmetic.ores",
    "parity:js": "node bin/js-semantic-parity-report.mjs",
    "parity:numeric-js": "node bin/js-numeric-boundary-report.mjs",
    "static-facts:smoke": "node bin/oreslang-jsc.mjs --static-facts tests/fixtures/forward-call.ores",
    "test:workers": "node --test tests/worker-node.test.mjs tests/worker-guest-scalar-e2e.test.mjs tests/worker-protocol-admission.test.mjs tests/worker-endpoint-admission.test.mjs tests/worker-real-integration.test.mjs tests/worker-copy-budget.test.mjs tests/worker-mailbox-bytes.test.mjs tests/worker-wire-allowlist.test.mjs tests/worker-wire-compat.test.mjs tests/worker-mailbox-invariants.test.mjs tests/worker-wire-real.test.mjs tests/worker-wire-error-brand.test.mjs tests/worker-malformed-error.test.mjs tests/worker-frame-getter-failure.test.mjs tests/worker-blob-type-budget.test.mjs tests/worker-resizable-buffer-budget.test.mjs tests/worker-negative-result-getter.test.mjs",
    "test:browser": "node scripts/browser-worker-smoke.mjs",
    "test:core": "node --test tests/freestanding-core.test.mjs",
    "test:core-browser": "node scripts/browser-core-smoke.mjs",
    "test:core-link": "node --test tests/core-linked-application.test.mjs",
    "serve:browser": "node scripts/serve-browser-fixtures.mjs",
    "test:core-bool": "node --test tests/core-boolean.test.mjs",
    "test:conditionals": "node --test tests/conditional-parity.test.mjs",
    "test:core-option-result": "node --test tests/core-option-result.test.mjs",
    "test:core-adt-match": "node --test tests/core-adt-match.test.mjs",
    "test:core-adt-conformance": "node --test tests/core-adt-match-conformance.test.mjs tests/core-adt-match-diagnostics.test.mjs",
    "test:conditional-adt": "node --test tests/conditional-adt-integration.test.mjs tests/conditional-adt-boundaries.test.mjs",
    "test:named-args": "node --test tests/named-arguments.test.mjs",
    "test:symbols": "node --test tests/symbol-v1.test.mjs",
    "test:symbol-wire": "node --test tests/symbol-equality-wire-v1.test.mjs tests/symbol-wire-v1.test.mjs",
    "test:program-classes": "node --test tests/program-classes-v2.test.mjs",
    "test:class-methods": "node --test tests/class-methods-compat-v1.test.mjs"
  }
}
