{
  "schema": "oreslang.structural_tuple_v2_security.v1",
  "revision": 1,
  "tuple_arity": {
    "min": 2,
    "max": 64
  },
  "overload_family_max": 128,
  "optional_slots": "trailing_suffix_only",
  "structural_view": {
    "readonly": true,
    "nonescaping": true,
    "hidden_tail_must_be_closed_readonly_safe": true,
    "runtime_shape_dispatch": false
  },
  "spread": {
    "explicit_only": true,
    "evaluate_source_once": true,
    "direct_arity_precedes_pack": true,
    "no_fallback_after_direct_selection": true,
    "pack_requires_unique_static_candidate": true,
    "same_arity_shape_overloading": false
  },
  "disallowed_proof_types": [
    "unknown",
    "generic",
    "borrow",
    "mutable-borrow",
    "function",
    "actor-ref",
    "class-namespace",
    "dynamic-list",
    "fixed-array",
    "fixed-list",
    "void",
    "null"
  ],
  "abi": {
    "no_numeric_coercion": true,
    "no_padding": true,
    "no_implicit_flatten": true,
    "omitted_optional_is_absence_not_null": true,
    "lexical_evaluation_order_preserved": true
  },
  "evidence": {
    "source_free_contract_is_not_runtime_parity": true,
    "zero_step_jobs": "NOT_EXECUTED",
    "exact_head_required": true,
    "private_source_export_requires_independent_authorization": true
  }
}
