{
  "contract": "oreslang-shared-domain-arena-v1",
  "version": 1,
  "status": "source-free-contract-only",
  "scope": "shared-domain ownership, typed authority, critical access and quiescent retirement; no guest/runtime parity certification",
  "lifecycle_order": [
    "create-domain",
    "issue-control",
    "grant-membership",
    "critical-access",
    "logical-retire",
    "authority-revocation",
    "quiescence",
    "byte-scrub",
    "physical-reclamation"
  ],
  "source_semantics": {
    "critical_read": "lexical-nonsuspending-read-lease",
    "critical_write": "lexical-nonsuspending-exclusive-lease",
    "guest_callback_while_locked": "forbidden",
    "busy_policy": "fail-fast-scheduler-retry",
    "rt_share": "unsupported-until-guest-lowering-and-source-conformance"
  },
  "backend_support": {
    "java": {
      "host_shared_domain": "unsupported",
      "guest_critical_lowering": "unsupported",
      "rt_share": "unsupported",
      "exact_head_runtime_evidence": "pending"
    },
    "llvm": {
      "host_shared_domain": "candidate-host-prototype",
      "guest_critical_lowering": "unsupported",
      "rt_share": "unsupported",
      "exact_head_runtime_evidence": "pending"
    },
    "net": {
      "host_shared_domain": "unsupported",
      "guest_critical_lowering": "unsupported",
      "rt_share": "unsupported",
      "exact_head_runtime_evidence": "pending"
    },
    "wasm": {
      "host_shared_domain": "unsupported",
      "guest_critical_lowering": "unsupported",
      "rt_share": "unsupported",
      "exact_head_runtime_evidence": "pending"
    },
    "forge": {
      "host_shared_domain": "unsupported",
      "guest_critical_lowering": "unsupported",
      "rt_share": "unsupported",
      "exact_head_runtime_evidence": "pending"
    }
  },
