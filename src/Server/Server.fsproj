<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Giraffe" Version="8.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../vendor/opto-sync-clients/clients/dotnet/src/OptoSync.FSharp/OptoSync.FSharp.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../public/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
